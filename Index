<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>14 Days of Interactions</title>
<style>
  :root {
    --bg: #0d0d0d;
    --card-bg: #161616;
    --border: #2a2a2a;
    --text: #f0f0f0;
    --muted: #8a8a8a;
    --accent: #f0f0f0;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    padding: 64px 24px;
  }
  .wrap { max-width: 880px; margin: 0 auto; }
  header { margin-bottom: 48px; }
  h1 {
    font-size: clamp(28px, 5vw, 40px);
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }
  header p {
    color: var(--muted);
    margin: 0;
    font-size: 15px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .card {
    display: block;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 18px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card .day {
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }
  .card .title {
    font-size: 16px;
    font-weight: 600;
  }
  .card.empty {
    border-style: dashed;
    color: var(--muted);
    pointer-events: none;
  }
  footer {
    margin-top: 56px;
    color: var(--muted);
    font-size: 13px;
  }
  footer a { color: var(--muted); }
</style>
</head>
<body>
  <div class="wrap">
    <header>
      <h1>14 Days of Interactions</h1>
      <p>One UI interaction a day, built and posted. Updated daily.</p>
    </header>

    <div class="grid">
      <!-- Duplicate this block for each completed day, update href/day/title -->
      <a class="card" href="days/day-01-magnetic-button.html">
        <div class="day">Day 01</div>
        <div class="title">Magnetic Button</div>
      </a>

      <!-- Placeholder for days not yet built — remove as you fill them in -->
      <div class="card empty">
        <div class="day">Day 02</div>
        <div class="title">Coming soon</div>
      </div>
      <div class="card empty">
        <div class="day">Day 03</div>
        <div class="title">Coming soon</div>
      </div>
    </div>

    <footer>
      Built daily &middot; <a href="https://github.com/" target="_blank">source</a>
    </footer>
  </div>
</body>
</html>
